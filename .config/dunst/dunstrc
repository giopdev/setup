[global]
    follow = mouse
    origin = top-right
    offset = (12, 40)
    width = (240, 360)
    notification_limit = 5
    font = Sans 11
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    corner_radius = 6
    icon_position = left
    max_icon_size = 48
    format = "<b>%s</b>\n%b"
    markup = full
    word_wrap = true
    alignment = left
    stack_duplicates = true
    show_age_threshold = 60

[urgency_low]
    timeout = 4

[urgency_normal]
    timeout = 6

[urgency_critical]
    timeout = 0
